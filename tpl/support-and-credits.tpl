{include file='globalheader.tpl'}
<div id="page-support-and-credits" class="admin-page">
    <div class="col-12 col-md-8 mx-auto">
        <div class="card shadow">
            <div class="card-body">
                <img src="{$Path}img/hellomeet-logo.png" alt="HelloMeet" class="img-fluid d-block mx-auto mb-3"
                    style="max-width: 360px; width: 100%;">
                <h1 class="text-center border-bottom">About HelloMeet</h1>
                <p>HelloMeet helps your team book meeting rooms, desks, and equipment.</p>
                <h2 id="getting-started">Getting started</h2>
                <ol>
                    <li>Administrators set office hours in Application Management &gt; Schedules.</li>
                    <li>Add rooms, desks, and equipment in Application Management &gt; Resources.</li>
                    <li>Open Schedule &gt; Bookings, select a resource and an available time, and save a reservation.</li>
                    <li>Manage your account, password, and notification preferences from My Account.</li>
                </ol>
                <h2>Support</h2>
                <p>For help with HelloMeet, visit <a class="link-primary" href="https://www.hellopixels.com"
                        target="_blank" rel="noopener noreferrer">HelloPixels</a>.</p>
                <div class="hellopixels-about my-4 text-center">
                    <h2>Powered by HelloPixels</h2>
                    <a href="https://www.hellopixels.com" target="_blank" rel="noopener noreferrer">
                        <img src="{$Path}img/hellopixels/logo.png" alt="HelloPixels" width="120" height="120">
                        <span class="d-block mt-2">www.hellopixels.com</span>
                    </a>
                    <p class="mt-2 mb-0">HelloMeet is developed and maintained by HelloPixels LLC.</p>
                </div>
                <h2>Credits and license</h2>
                <p>HelloMeet is maintained by HelloPixels LLC and is based on LibreBooking and Booked Scheduler.
                    Original copyright and license notices are retained.</p>
                <p><a class="link-primary" href="https://www.gnu.org/licenses/gpl-3.0.html"
                        target="_blank" rel="noopener noreferrer">GNU General Public License v3</a></p>
            </div>
        </div>
    </div>
</div>
{include file='javascript-includes.tpl'}
